<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>《鏡像審訊》Mirror Interrogation</title>
    <style>
        /* 全局色調與字體規範 */
        :root {
            --base-dark: #080A0C;
            --terminal-cyan: #00E5A3;
            --memory-amber: #E6A100;
            --danger-crimson: #FF2E4C;
            --narrative-gray: #D1D5DB;
            --crt-line: rgba(0, 229, 163, 0.05);
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            background-color: var(--base-dark);
            color: var(--terminal-cyan);
            font-family: 'Courier New', Courier, monospace;
            overflow: hidden;
            user-select: none;
        }

        /* CRT 掃描線與螢幕邊緣閃爍特效 */
        .crt-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            background-size: 100% 4px, 3px 100%;
            pointer-events: none;
            z-index: 999;
            opacity: 0.8;
        }

        /* 遊戲主體 16:9 比例容器 */
        #game-container {
            display: flex;
            flex-direction: column;
            width: 100vw;
            max-width: 177.78vh; /* 16:9 aspect ratio */
            height: 100vh;
            max-height: 56.25vw;
            margin: auto;
            position: relative;
            background-color: #050709;
            box-shadow: 0 0 50px rgba(0,229,163,0.1) inset;
        }

        /* 頂部狀態欄 */
        #header {
            display: flex;
            justify-content: space-between;
            padding: 10px 20px;
            border-bottom: 1px solid var(--terminal-cyan);
            font-weight: bold;
            font-size: 0.9rem;
            text-shadow: 0 0 5px var(--terminal-cyan);
        }

        /* 主畫面區塊 (左 70% : 右 30%) */
        #main-content {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        /* 左區：歷史紀錄與提問區 */
        #left-panel {
            flex: 0 0 70%;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(0, 229, 163, 0.3);
            padding: 15px;
            box-sizing: border-box;
        }

        #chat-history {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 15px;
            padding-right: 10px;
            scrollbar-width: thin;
            scrollbar-color: var(--terminal-cyan) var(--base-dark);
        }

        #chat-history::-webkit-scrollbar { width: 6px; }
        #chat-history::-webkit-scrollbar-thumb { background: var(--terminal-cyan); }

        .log-entry { margin-bottom: 15px; line-height: 1.5; }
        .log-player { color: var(--terminal-cyan); }
        .log-w { color: var(--narrative-gray); border-left: 2px solid var(--narrative-gray); padding-left: 10px; margin-top: 5px; }

        /* 提問選項抽屜 */
        #question-drawer {
            height: 35%;
            overflow-y: auto;
            border-top: 1px dashed var(--terminal-cyan);
            padding-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .question-btn {
            background: transparent;
            color: var(--terminal-cyan);
            border: 1px solid rgba(0, 229, 163, 0.4);
            padding: 10px;
            text-align: left;
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .question-btn:hover {
            background: rgba(0, 229, 163, 0.1);
            border-color: var(--terminal-cyan);
            box-shadow: 0 0 8px rgba(0, 229, 163, 0.5);
        }

        .question-btn.torture { color: var(--danger-crimson); border-color: rgba(255, 46, 76, 0.4); }
        .question-btn.torture:hover { background: rgba(255, 46, 76, 0.1); border-color: var(--danger-crimson); box-shadow: 0 0 8px rgba(255, 46, 76, 0.5); }

        /* 右區：W 動態觀察 */
        #right-panel {
            flex: 0 0 30%;
            padding: 15px;
            box-sizing: border-box;
            background: linear-gradient(90deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0) 100%);
            display: flex;
            flex-direction: column;
        }

        .observation-title {
            color: var(--danger-crimson);
            font-size: 0.8rem;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        #w-status-log {
            color: var(--narrative-gray);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* 底部儀表 */
        #footer {
            display: flex;
            justify-content: space-between;
            padding: 8px 20px;
            border-top: 1px solid var(--terminal-cyan);
            font-size: 0.8rem;
            background-color: rgba(0, 229, 163, 0.05);
        }

        /* 雙關語 tooltip 效果 */
        .secret-word {
            color: var(--terminal-cyan);
            border-bottom: 1px dashed var(--memory-amber);
            position: relative;
            cursor: help;
        }
        
        .secret-word:hover {
            color: var(--memory-amber);
            text-shadow: 0 0 5px var(--memory-amber);
        }

        .secret-word::after {
            content: attr(data-secret);
            position: absolute;
            bottom: 100%; left: 50%;
            transform: translateX(-50%);
            background: var(--base-dark);
            color: var(--memory-amber);
            border: 1px solid var(--memory-amber);
            padding: 4px 8px;
            font-size: 0.8rem;
            white-space: nowrap;
            opacity: 0; pointer-events: none;
            transition: opacity 0.2s;
            z-index: 10;
        }
        
        .secret-word:hover::after { opacity: 1; }

        /* 黑屏轉場與結局畫面 */
        #black-screen {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-color: #000;
            z-index: 1000;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 1;
            transition: opacity 3.5s ease-in-out;
            pointer-events: none;
        }

        #night-echo-text {
            color: var(--memory-amber);
            font-size: 1.2rem;
            text-align: center;
            max-width: 60%;
            line-height: 2;
            letter-spacing: 2px;
        }

        .glitch { animation: glitch 0.2s linear infinite; }
        @keyframes glitch {
            0% { filter: invert(0); transform: translate(0); }
            20% { filter: invert(1); transform: translate(-2px, 1px); }
            40% { filter: invert(0); transform: translate(2px, -1px); }
            60% { filter: invert(1); transform: translate(-1px, 2px); }
            100% { filter: invert(0); transform: translate(0); }
        }

        #start-screen {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-color: var(--base-dark);
            z-index: 2000;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        #start-screen input {
            background: transparent;
            border: none;
            border-bottom: 2px solid var(--terminal-cyan);
            color: var(--terminal-cyan);
            font-size: 1.5rem;
            text-align: center;
            margin: 20px 0;
            outline: none;
            font-family: 'Courier New', monospace;
        }
    </style>
</head>
<body>

    <div class="crt-overlay"></div>

    <!-- 遊戲開始輸入名稱 -->
    <div id="start-screen">
        <h1 style="color: var(--terminal-cyan); letter-spacing: 5px;">[ 鏡像審訊系統 v3.1.4 ]</h1>
        <p style="color: var(--narrative-gray);">請輸入您的授權代號 (真名)：</p>
        <input type="text" id="player-name-input" value="小白鼠" autocomplete="off">
        <button class="question-btn" onclick="startGame()">登入系統</button>
    </div>

    <!-- 漸隱黑屏區 -->
    <div id="black-screen">
        <div id="night-echo-text"></div>
    </div>

    <!-- 遊戲主畫面 -->
    <div id="game-container" style="opacity: 0;">
        <div id="header">
            <span id="ui-time">系統時間: DAY 1 - 14:00</span>
            <span id="ui-remain">剩餘問題: 9/9</span>
            <span id="ui-wave">監控波形: 正常 [||||||....]</span>
        </div>

        <div id="main-content">
            <div id="left-panel">
                <div id="chat-history">
                    <div class="log-entry log-player">系統啟動。審訊對象：W。身份：危險武裝份子。<br>請從下方資料庫提取問題進行審訊。</div>
                </div>
                <div id="question-drawer">
                    <!-- 動態生成問題按鈕 -->
                </div>
            </div>

            <div id="right-panel">
                <div class="observation-title">▶ 嫌疑人行為監控 (W)</div>
                <div id="w-status-log">
                    目標被固定在拘束椅上，低垂著頭。聽見終端啟動的聲音，他緩緩抬起眼簾，隔著單向玻璃看向你所在的方向。
                </div>
            </div>
        </div>

        <div id="footer">
            <span id="ui-bpm">心率: 72 BPM</span>
            <span id="ui-brain">腦波異常度: 0%</span>
            <span style="color: var(--danger-crimson);">監聽狀態: 錄音中</span>
        </div>
    </div>

<script>
    // 遊戲核心數據
    let gameState = {
        day: 1,
        questionsAskedToday: 0,
        maxQuestionsPerDay: 9,
        playerName: "小白鼠",
        stats: {
            Trust_P: 10,
            Kill_P: 20,
            Know_Pw: 0,
            Health_W: 100,
            Grief_W: 0,
            Know_Wp: 0
        },
        askedQuestions: new Set()
    };

    // 劇本庫 (節錄代表性問題)
    const questionsDB = [
        { id: "q1", day: 1, text: "交代你的組織名稱，以及你們在地下網路的節點。", isTorture: false, action: () => { updateStats('Kill_P', 5); updateStats('Trust_P', -5); }, response: "組織？我們只是在尋找被你們關在籠子裡的家人。", wAction: "W 發出一聲微弱的冷笑，鎖鏈因身體的震動發出清脆的碰撞聲。" },
        { id: "q2", day: 1, text: "三年前的海域襲擊案，是你一手策劃的嗎？", isTorture: false, action: () => { updateStats('Know_Pw', 5); updateStats('Grief_W', 5); triggerGlitch(); }, response: "那不是襲擊……那是救援。可惜<span class='secret-word' data-secret='西側海岸接頭點'>海水</span>太冷，我把最重要的人弄丟了。", wAction: "W 猛地抬起頭，死死盯著你。他的眼底閃過一絲痛苦。" },
        { id: "q3", day: 1, text: "你身上的舊槍傷，看起來像是某種研究所的防衛武器造成的。", isTorture: false, action: () => { updateStats('Know_Pw', 10); updateStats('Know_Wp', 10); }, response: "你看得很準。那是為了帶一隻迷路的小傢伙出來而留下的紀念。", wAction: "他的目光不自覺地掃過你的手腕，眼神深邃。" },
        { id: "q4", day: 1, text: "[啟動高壓電擊] 這能讓你的嘴巴變硬還是變軟？", isTorture: true, action: () => { updateStats('Health_W', -20); updateStats('Kill_P', 15); updateStats('Grief_W', 15); }, response: "你的手法……比研究所的自動注射器還要生疏……", wAction: "高壓電流貫穿軀體，W 劇烈痙攣，指甲深深嵌入掌心，鮮血滴落。" },
        { id: "q5", day: 1, text: "審訊記錄顯示你對特定的鎮靜劑成分有免疫，為什麼？", isTorture: false, action: () => { updateStats('Know_Pw', 10); updateStats('Trust_P', 5); }, response: "因為那種藥……我曾經每天親手調配給一隻<span class='secret-word' data-secret='你的真實身份'>白鼠</span>喝。為了減輕他的痛苦。", wAction: "他放輕了呼吸，語氣中帶著難以察覺的溫柔。" },
        { id: "q6", day: 1, text: "你投降得太輕易了，就像是故意被我們抓到一樣。", isTorture: false, action: () => { updateStats('Trust_P', 10); updateStats('Know_Wp', 10); }, response: "不站在這個位置，我怎麼能離你這麼近？", wAction: "嘴角勾起一抹微弱的笑意，那是他進來後第一次放鬆面部肌肉。" },
        { id: "q7", day: 2, text: "我最近經常夢見海水與針頭的氣味，這和你有關嗎？", isTorture: false, action: () => { updateStats('Know_Pw', 20); updateStats('Know_Wp', 20); updateStats('Grief_W', -10); triggerGlitch(); }, response: "你想起來了？你還記得<span class='secret-word' data-secret='西側海岸線'>海鹽</span>踩在腳下的聲音嗎？", wAction: "W 的呼吸瞬間變得極度急促，身體前傾，試圖看清玻璃後你的表情。" },
        { id: "q8", day: 2, text: "政府說你是個瘋狂的基因改造專家，你拿活體做實驗。", isTorture: false, action: () => { updateStats('Trust_P', -5); updateStats('Grief_W', 15); }, response: "我是罪人……但我唯一的罪，是沒有在第一天就帶你遠走高飛。", wAction: "眼神瞬間暗淡下去，自嘲地閉上了眼睛。" },
        { id: "q9", day: 2, text: "單體變身能力……真的能完全複製一個人的記憶和情感嗎？", isTorture: false, action: () => { updateStats('Know_Pw', 15); updateStats('Know_Wp', 10); }, response: "不能。變身只能複製外表，但當你變成對方最親近的人時，你的心會跟著一起疼。", wAction: "隔著單向玻璃，他似乎想要伸手觸碰你的臉頰輪廓。" },
        { id: "q10", day: 2, text: "監控室正看著我們的一舉一動，你的每一句話都會成為定罪依據。", isTorture: false, action: () => { updateStats('Trust_P', 10); }, response: "那麼，請繼續審訊吧，審訊官大人。", wAction: "W 瞭然地點點頭，迅速收起了所有情緒，坐姿變得公事公辦。" },
        { id: "q11", day: 2, text: "明天的審訊是最後期限，高層不會給我更多時間了。", isTorture: false, action: () => { updateStats('Trust_P', 15); updateStats('Know_Wp', 15); }, response: "足夠了。<span class='secret-word' data-secret='明日下午三點斷電攻堅'>三點鐘方向的潮汐</span>退去的時候，船會開。", wAction: "他豎起三根手指，假裝不經意地整理了一下領口。" },
        { id: "q12", day: 3, text: "永遠維持人形的代價是什麼？", isTorture: false, action: () => { updateStats('Know_Pw', 20); }, response: "代價是……你會忘記自己曾經是一隻自由的<span class='secret-word' data-secret='找回自我'>白鼠</span>，忘記我撫摸你背脊的溫度。", wAction: "W 的聲音開始顫抖，帶著濃烈的悲哀與不捨。" },
        { id: "q13", day: 3, text: "你後悔過當年帶我逃跑嗎？", isTorture: false, action: () => { updateStats('Trust_P', 20); updateStats('Grief_W', -20); }, response: "這是我這輩子做過唯一正確的事。", wAction: "眼角滑落一滴眼淚，但他卻露出了最釋懷的笑容。" },
        { id: "q14", day: 3, text: "這是處決同意書，只要我簽字，安樂死藥劑五分鐘內就會注入。", isTorture: false, action: () => { updateStats('Kill_P', 20); updateStats('Grief_W', 25); }, response: "簽吧。死在你手裡，總好過死在那些研究員的解剖台上。", wAction: "絕望地靠在椅背上，放棄了所有抵抗姿態。" },
        { id: "q15", day: 3, text: "（將眼神移向他扣緊的左手袖口）……你握著的那張紙條，是給我的，還是給外面的那些人？", isTorture: false, condition: () => gameState.stats.Know_Pw >= 40 && gameState.stats.Trust_P >= 40, action: () => { updateStats('Know_Wp', 30); }, response: "（無聲）", wAction: "W 眼睛驟然亮起，重重地敲擊了桌面三下。" }
    ];

    // 初始化遊戲
    function startGame() {
        let nameInput = document.getElementById("player-name-input").value.trim();
        if(nameInput) gameState.playerName = nameInput;
        
        document.getElementById("start-screen").style.display = "none";
        document.getElementById("black-screen").style.opacity = "0";
        document.getElementById("game-container").style.opacity = "1";
        
        loadDailyQuestions();
        updateUI();
    }

    // 讀取當天問題
    function loadDailyQuestions() {
        const drawer = document.getElementById("question-drawer");
        drawer.innerHTML = "";
        
        let availableQuestions = questionsDB.filter(q => 
            q.day === gameState.day && 
            !gameState.askedQuestions.has(q.id) &&
            (!q.condition || q.condition())
        );

        // 如果題庫不夠9題（原型展示用），自動補足或調整限制
        gameState.maxQuestionsPerDay = Math.min(5, availableQuestions.length); // 為了快速展示，每天設為 5 題
        gameState.questionsAskedToday = 0;

        availableQuestions.forEach(q => {
            let btn = document.createElement("button");
            btn.className = `question-btn ${q.isTorture ? 'torture' : ''}`;
            btn.innerText = q.text;
            btn.onclick = () => handleQuestionClick(q, btn);
            drawer.appendChild(btn);
        });
    }

    // 處理提問
    function handleQuestionClick(q, btnElement) {
        btnElement.remove();
        gameState.askedQuestions.add(q.id);
        gameState.questionsAskedToday++;
        
        q.action();
        updateUI();
        
        // 渲染對話到左側
        appendChatLog("log-player", `> 發送語音: "${q.text}"`);
        
        // 禁用抽屜直到回復完畢
        document.getElementById("question-drawer").style.pointerEvents = "none";
        
        setTimeout(() => {
            appendChatLog("log-w", q.response);
            updateNarrative(q.wAction);
            document.getElementById("question-drawer").style.pointerEvents = "auto";
            
            checkDayProgress();
        }, 1000);
    }

    // 附加歷史紀錄
    function appendChatLog(className, htmlContent) {
        const history = document.getElementById("chat-history");
        const entry = document.createElement("div");
        entry.className = `log-entry ${className}`;
        history.appendChild(entry);
        
        // 打字機特效
        let i = 0;
        let isTag = false;
        let text = htmlContent;
        
        entry.innerHTML = "";
        function typeWriter() {
            if (i < text.length) {
                if(text.charAt(i) === '<') isTag = true;
                
                if(isTag) {
                    let tagClose = text.indexOf('>', i);
                    entry.innerHTML += text.substring(i, tagClose + 1);
                    i = tagClose + 1;
                    isTag = false;
                } else {
                    entry.innerHTML += text.charAt(i);
                    i++;
                }
                history.scrollTop = history.scrollHeight;
                setTimeout(typeWriter, 35);
            }
        }
        typeWriter();
    }

    // 更新 W 的狀態敘述
    function updateNarrative(text) {
        const narrativeDiv = document.getElementById("w-status-log");
        narrativeDiv.innerHTML = "";
        let i = 0;
        function type() {
            if (i < text.length) {
                narrativeDiv.innerHTML += text.charAt(i);
                i++;
                setTimeout(type, 30);
            }
        }
        type();
    }

    // 更新 UI 數值
    function updateStats(key, value) {
        gameState.stats[key] += value;
        // 限制範圍
        if(gameState.stats[key] > 100) gameState.stats[key] = 100;
        if(gameState.stats[key] < 0) gameState.stats[key] = 0;
    }

    function updateUI() {
        document.getElementById("ui-time").innerText = `系統時間: DAY ${gameState.day} - 14:00`;
        document.getElementById("ui-remain").innerText = `剩餘問題: ${gameState.maxQuestionsPerDay - gameState.questionsAskedToday}/${gameState.maxQuestionsPerDay}`;
        
        // 隱藏數值顯性化
        let heartRate = 72 + Math.floor(gameState.stats.Kill_P * 0.5);
        document.getElementById("ui-bpm").innerText = `心率: ${heartRate} BPM`;
        
        let brainwave = gameState.stats.Know_Pw;
        document.getElementById("ui-brain").innerText = `腦波異常度: ${brainwave}%`;
        
        let waveStr = "正常";
        if(gameState.stats.Kill_P > 60) waveStr = "高危警告";
        if(gameState.stats.Know_Pw > 60) waveStr = "記憶干擾";
        document.getElementById("ui-wave").innerText = `監控波形: ${waveStr}`;
    }

    // 檢查日程進度
    function checkDayProgress() {
        if (gameState.questionsAskedToday >= gameState.maxQuestionsPerDay) {
            setTimeout(() => {
                if (gameState.day < 3) {
                    triggerNightEcho();
                } else {
                    triggerEnding();
                }
            }, 2000);
        }
    }

    // 黑屏過渡與心聲 (Night Echo)
    function triggerNightEcho() {
        const blackScreen = document.getElementById("black-screen");
        const echoText = document.getElementById("night-echo-text");
        
        blackScreen.style.opacity = "1";
        
        let echoMsg = "";
        if(gameState.day === 1) {
            echoMsg = "夜深了。你洗臉時看著鏡子，水滴滑落的瞬間，鏡中的你短暫地呈現出了一具白骨與鼠鬚的模樣。你感到劇烈的頭痛...";
        } else if (gameState.day === 2) {
            echoMsg = "半夜，你聽見了海浪聲。醒來時，你發現自己在桌上的廢紙上，密密麻麻寫滿了同一個名字——【" + gameState.playerName + "】。";
        }

        setTimeout(() => {
            echoText.innerHTML = "";
            let i = 0;
            function type() {
                if (i < echoMsg.length) {
                    echoText.innerHTML += echoMsg.charAt(i);
                    i++;
                    setTimeout(type, 80);
                } else {
                    setTimeout(() => {
                        gameState.day++;
                        loadDailyQuestions();
                        updateUI();
                        echoText.innerHTML = "";
                        blackScreen.style.opacity = "0";
                        document.getElementById("chat-history").innerHTML = ""; // 清空隔天歷史
                        appendChatLog("log-player", `系統重啟。DAY ${gameState.day} 審訊開始。`);
                        updateNarrative("新的一天。W 看起來比昨天更加虛弱，但他的眼神依舊鎖定在你的方向。");
                    }, 3000);
                }
            }
            type();
        }, 3500);
    }

    // 結局判定與非公式化場景描寫
    function triggerEnding() {
        const blackScreen = document.getElementById("black-screen");
        const echoText = document.getElementById("night-echo-text");
        blackScreen.style.opacity = "1";

        let endingScene = "";
        const s = gameState.stats;

        if (s.Know_Pw >= 40 && s.Trust_P >= 40) {
            // True Ending 坦途 (條件降低以適應短版原型)
            endingScene = `審訊室的燈光驟然熄滅，備用電源被切斷的警報聲響徹走廊。<br><br>在黑暗中，你輕輕喚出了那個名字——「${gameState.playerName}」。<br><br>槍聲戛然而止。W 撕開了護腕，合金門被外部爆破。你們在混亂與硝煙中狂奔，直到海風吹拂過臉頰，遠處的警笛聲漸漸被海浪吞沒。<br><br>這一次，你們不再是籠中的白鼠。`;
        } else if (s.Kill_P >= 50) {
            // 憎恨/暴力
            endingScene = `你扣下了扳機。火光照亮了單向玻璃，W 倒在血泊中，沒有反抗，眼裡只有無盡的悲憫。<br><br>就在鮮血蔓延到你腳邊的瞬間，被封鎖的記憶如海嘯般反噬。你記起了海浪，記起了那個為了救你而甘願重返地獄的身影。<br><br>你跪在屍體旁，發出了不似人類的絕望嘶吼。`;
        } else if (s.Health_W <= 0) {
            // 遺憾
            endingScene = `高壓電流最終超過了心臟的負荷。W 的頭顱無力地垂下，再也沒有抬起來。<br><br>後來，政府將你晉升為高級調查員。你擁有一切，只是每當看見海水，或是聞到醫用酒精的味道時，你的心臟都會傳來一陣空洞的刺痛，彷彿弄丟了什麼再也找不回來的東西。`;
        } else {
            // 忠誠犬隻 (未曾)
            endingScene = `三天的審訊結束，W 作為無價值的恐怖分子被推上了處決台。<br><br>你站在高牆上，冷漠地注視著行刑。隔天，你服下了政府發放的記憶抑制劑，繼續作為一條冰冷、高效的獵犬，完美地執行下一個任務。<br><br>真相，永遠沉入了深海。`;
        }

        setTimeout(() => {
            echoText.style.color = "var(--terminal-cyan)";
            echoText.style.textAlign = "left";
            echoText.innerHTML = endingScene;
            // 淡入結局文字
            echoText.style.opacity = 0;
            echoText.style.transition = "opacity 2s";
            setTimeout(() => { echoText.style.opacity = 1; }, 100);
        }, 3500);
    }

    // 記憶閃爍特效 (Glitch)
    function triggerGlitch() {
        document.body.classList.add("glitch");
        setTimeout(() => {
            document.body.classList.remove("glitch");
        }, 300);
    }

</script>
